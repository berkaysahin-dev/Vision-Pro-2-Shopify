{%- comment -%}
  ATELIER LUXE — FACETED STOREFRONT FILTERS SNIPPET
  Native Shopify OS 2.0 Storefront Filtering & Sorting
{%- endcomment -%}

<div class="facet-filters">
  <form id="FacetFiltersForm" class="facet-filters__form">
    <!-- Active Filters Pills -->
    {%- assign has_active_filters = false -%}
    {%- for filter in results.filters -%}
      {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}
        {%- assign has_active_filters = true -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_active_filters -%}
      <div class="active-facets" style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; align-items: center;">
        <span style="font-size: 12px; font-weight: 600; text-transform: uppercase;">Active Filters:</span>
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}" class="badge badge-outline" style="display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none;">
              {{ value.label }}
              <span>✕</span>
            </a>
          {%- endfor -%}
          {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
            <a href="{{ filter.url_to_remove }}" class="badge badge-outline" style="display: inline-flex; align-items: center; gap: 0.35rem;">
              {{ filter.min_value.value | default: 0 | money }} - {{ filter.max_value.value | default: filter.range_max | money }}
              <span>✕</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ results.url }}" style="font-size: 12px; text-decoration: underline; color: var(--color-sale); margin-left: 0.5rem;">
          {{ 'collections.general.clear_all' | t | default: 'Clear All' }}
        </a>
      </div>
    {%- endif -%}

    <!-- Filter Accordion Groups -->
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      {%- for filter in results.filters -%}
        <div class="faq-item is-open" style="border-top: 1px solid var(--color-border); padding-top: 0.75rem;">
          <div class="faq-header" style="padding: 0.5rem 0; font-size: 14px;">
            <span>{{ filter.label }}</span>
            <span class="faq-icon">{% render 'icon', icon: 'chevron-down' %}</span>
          </div>
          <div class="faq-content" style="max-height: 300px; overflow-y: auto;">
            {%- case filter.type -%}
              {%- when 'boolean', 'list' -%}
                <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; padding: 0.5rem 0;">
                  {%- for value in filter.values -%}
                    <li style="display: flex; align-items: center; gap: 0.5rem; font-size: 13px;">
                      <input
                        type="checkbox"
                        name="{{ value.param_name }}"
                        value="{{ value.value }}"
                        id="Filter-{{ filter.param_name }}-{{ forloop.index }}"
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        onchange="this.closest('form').submit();"
                        style="cursor: pointer;"
                      >
                      <label for="Filter-{{ filter.param_name }}-{{ forloop.index }}" style="cursor: pointer; display: flex; justify-content: space-between; width: 100%;">
                        <span>{{ value.label }}</span>
                        <span class="text-muted">({{ value.count }})</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>

              {%- when 'price_range' -%}
                <div style="display: flex; gap: 0.75rem; align-items: center; padding: 0.75rem 0;">
                  <div style="flex: 1;">
                    <label style="font-size: 11px; color: var(--color-text-muted);">From</label>
                    <input
                      type="number"
                      name="{{ filter.min_value.param_name }}"
                      class="form-input"
                      placeholder="0"
                      min="0"
                      max="{{ filter.range_max | divided_by: 100 }}"
                      value="{{ filter.min_value.value | divided_by: 100 }}"
                      style="height: 36px; font-size: 13px;"
                    >
                  </div>
                  <div style="flex: 1;">
                    <label style="font-size: 11px; color: var(--color-text-muted);">To</label>
                    <input
                      type="number"
                      name="{{ filter.max_value.param_name }}"
                      class="form-input"
                      placeholder="{{ filter.range_max | divided_by: 100 }}"
                      min="0"
                      max="{{ filter.range_max | divided_by: 100 }}"
                      value="{{ filter.max_value.value | divided_by: 100 }}"
                      style="height: 36px; font-size: 13px;"
                    >
                  </div>
                  <button type="submit" class="btn btn-secondary btn-sm" style="height: 36px; margin-top: 16px;">Apply</button>
                </div>
            {%- endcase -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </form>
</div>
