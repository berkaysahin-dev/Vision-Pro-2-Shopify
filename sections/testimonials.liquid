<section class="section-spacing" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="section-header text-center">
      {%- if section.settings.subtitle != blank -%}
        <div class="section-subtitle">{{ section.settings.subtitle }}</div>
      {%- endif -%}
      <h2 class="h2">{{ section.settings.title | default: 'Acclaimed by Patrons & Designers' }}</h2>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">
            {%- for star in (1..5) -%}
              {% render 'icon', icon: 'star' %}
            {%- endfor -%}
          </div>
          <p class="testimonial-card__quote">
            "{{ block.settings.quote | default: 'The weight, tolerance, and tactile feel of the titanium stand is superior to any tech accessory I have owned. It feels like an architectural sculpture.' }}"
          </p>
          <div class="testimonial-card__author">
            <div>
              <div class="testimonial-card__name">{{ block.settings.author | default: 'Marcus Vance' }}</div>
              <div class="text-muted" style="font-size: 11px;">{{ block.settings.role | default: 'Industrial Designer, London' }}</div>
            </div>
            {%- if block.settings.verified -%}
              <div class="testimonial-card__verified">
                {% render 'icon', icon: 'shield-check' %}
                <span>Verified Patron</span>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials & Reviews",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Patron Perspective"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Acclaimed by Patrons & Designers"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Review Card",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer Review / Quote",
          "default": "The weight, tolerance, and tactile feel of the titanium stand is superior to any tech accessory I have owned. It feels like an architectural sculpture on my desk."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Marcus Vance"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Location or Title",
          "default": "Industrial Designer, London"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Buyer Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials & Reviews",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The weight, tolerance, and tactile feel of the titanium stand is superior to any tech accessory I have owned. It feels like an architectural sculpture.",
            "author": "Marcus Vance",
            "role": "Industrial Designer, London"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Remarkable attention to detail. The French calfskin strap has aged beautifully with a deep rich patina. Exceptional luxury experience.",
            "author": "Elena Rostova",
            "role": "Creative Director, Milan"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Unboxing the monolithic case felt like unveiling an art piece. Delivery was seamless and arrived in Tokyo within 48 hours.",
            "author": "Kenji Takahashi",
            "role": "Architect, Tokyo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
