<section class="section-spacing" style="background-color: {{ section.settings.bg_color }};">
  <div class="container">
    <div class="showcase-grid">
      <!-- Media View -->
      <div class="showcase-media" data-reveal="fade-up">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #11141A 0%, #1A1F2B 100%); display: flex; align-items: center; justify-content: center; color: #475569; padding: 3rem;">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}
      </div>

      <!-- Tech Specs & Details -->
      <div style="display: flex; flex-direction: column; gap: var(--space-md);" data-reveal="fade-up">
        {%- if section.settings.badge != blank -%}
          <span class="badge badge-new" style="align-self: flex-start;">{{ section.settings.badge }}</span>
        {%- endif -%}

        <h2 class="h2">{{ section.settings.heading | default: 'Uncompromising Micro-Tolerances.' }}</h2>

        <p style="color: var(--color-text-muted); font-size: 1.0625rem; line-height: 1.7;">
          {{ section.settings.description | default: 'Machined from a monolithic billet of Grade 5 titanium, every bevel and surface is hand-finished to microscopic precision.' }}
        </p>

        <!-- Technical Specification Matrix -->
        <div class="showcase-specs">
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_1_val | default: 'Grade 5' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_1_label | default: 'Aerospace Titanium' }}</div>
          </div>
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_2_val | default: '0.02 mm' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_2_label | default: 'CNC Milling Precision' }}</div>
          </div>
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_3_val | default: '100%' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_3_label | default: 'Recycled Monolith Box' }}</div>
          </div>
          <div class="showcase-spec-item">
            <div class="showcase-spec-item__value">{{ section.settings.spec_4_val | default: 'Lifetime' }}</div>
            <div class="showcase-spec-item__label">{{ section.settings.spec_4_label | default: 'Structural Guarantee' }}</div>
          </div>
        </div>

        {%- if section.settings.cta_text != blank -%}
          <div style="margin-top: 1rem;">
            <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn-primary btn-lg">
              {{ section.settings.cta_text }} →
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Showcase",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Showcase Image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Engineering Spotlight"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Uncompromising Micro-Tolerances."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Machined from a monolithic billet of Grade 5 titanium, every bevel and surface is hand-finished to microscopic precision."
    },
    {
      "type": "text",
      "id": "spec_1_val",
      "label": "Spec 1 Value",
      "default": "Grade 5"
    },
    {
      "type": "text",
      "id": "spec_1_label",
      "label": "Spec 1 Label",
      "default": "Aerospace Titanium"
    },
    {
      "type": "text",
      "id": "spec_2_val",
      "label": "Spec 2 Value",
      "default": "0.02 mm"
    },
    {
      "type": "text",
      "id": "spec_2_label",
      "label": "Spec 2 Label",
      "default": "CNC Milling Precision"
    },
    {
      "type": "text",
      "id": "spec_3_val",
      "label": "Spec 3 Value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "spec_3_label",
      "label": "Spec 3 Label",
      "default": "Recycled Monolith Box"
    },
    {
      "type": "text",
      "id": "spec_4_val",
      "label": "Spec 4 Value",
      "default": "Lifetime"
    },
    {
      "type": "text",
      "id": "spec_4_label",
      "label": "Spec 4 Label",
      "default": "Structural Guarantee"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text",
      "default": "Acquire the Edition"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
